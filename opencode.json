{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".agents/rules/*.md"
  ],
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "agent": {
    "implementer": {
      "permission": {
        "skill": {
          "backend-developer": "allow",
          "frontend-developer": "allow"
        }
      }
    },
    "orchestrator": {
      "permission": {
        "skill": {
          "business-analysis": "allow"
        }
      }
    }
  }
}