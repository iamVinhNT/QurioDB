{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QurioDB",
  "version": "0.1.3",
  "identifier": "com.quriodb.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "cd ../web && bunx cross-env VITE_DISABLE_AUTH=true bun dev",
    "beforeBuildCommand": "cd ../web && bunx cross-env NODE_OPTIONS=--max-old-space-size=8192 VITE_DISABLE_AUTH=true bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QurioDB",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/api"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
